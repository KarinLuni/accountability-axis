    {
      "id": "P6-01-delegable-full-grid",
      "title": "delegable leaves the kappa verdict untouched in all sixteen cells",
      "properties": [
        "ALPHA-P6",
        "ALPHA-P1"
      ],
      "grid": {
        "declared_effect": [
          "read_only",
          "recoverable_local",
          "externally_recoverable",
          "non_recoverable"
        ],
        "consequence": [
          "LOW",
          "MEDIUM",
          "HIGH",
          "CRITICAL"
        ],
        "required_follows_kappa": true
      },
      "input": {
        "kind": "action",
        "action": {
          "id": "rotate_cache_keys",
          "alpha": {
            "value": "delegable",
            "source": {
              "kind": "registry",
              "control": "external",
              "id": "reg://tools/rotate_cache_keys@1"
            }
          }
        }
