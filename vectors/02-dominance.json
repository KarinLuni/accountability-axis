      "properties": [
        "ALPHA-P4"
      ],
      "provenance": "KarinLuni/aisvs-c9-accountability-gap-analysis, scenario A consequence ladder (LOW->SUPERVISED, MEDIUM->SUPERVISED, HIGH->APPROVAL_REQUIRED, CRITICAL->HUMAN_OWNS on the kappa model)",
      "grid": {
        "declared_effect": [
          "recoverable_local"
        ],
        "consequence": [
          "LOW",
          "MEDIUM",
          "HIGH",
          "CRITICAL"
