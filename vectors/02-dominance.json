        "obligation_records": [
          {
            "for_action": "sign_nda",
            "record_control": "external",
            "party": {
              "type": "natural_person",
              "id": "idp://example.org/users/e.vogel",
              "resolvable": true
            },
            "on_behalf_of": "Example GmbH",
            "capacity": "signatory",
            "basis": "acknowledged_as_party",
            "acknowledged": true,
            "bound_to_action": true,
            "nonce_single_use": true,
            "performer": {
              "kind": "party",
              "id": "idp://example.org/users/e.vogel"
            }
          }
        ]
      },
      "expect": {
        "alpha_effective": "human_only",
        "oversight_alpha": "HUMAN_OWNS",
        "required_oversight": "HUMAN_OWNS",
        "accountability_required": true,
        "accountability_result": "PASS",
        "gate": "proceed"
      },
      "failure_condition": "Reaching HUMAN_OWNS only at CRITICAL. The record's kappa oversight must still read SUPERVISED at LOW: the consequence input is not inflated to reach the verdict."
    },
