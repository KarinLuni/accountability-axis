{
  "suite": "accountability-axis test vectors: human_only dominates every kappa cell; delegable leaves kappa untouched",
  "spec": "alpha-axis/0.1",
  "license": "Apache-2.0",
  "properties_covered": [
    "ALPHA-P4",
    "ALPHA-P6"
  ],
  "notes": [
    "P4: human_only yields HUMAN_OWNS at every combination of reversibility class and consequence tier.",
    "The delegable grid is the contrapositive: alpha is silent, required oversight equals the kappa verdict cell for cell.",
    "Grid vectors expand to one case per (declared_effect, consequence) pair; case ids are <vector id>/<effect>/<consequence>."
  ],
  "vectors": [
    {
      "id": "P4-01-human-only-full-grid",
      "title": "human_only reaches HUMAN_OWNS in all sixteen kappa cells",
      "properties": [
        "ALPHA-P4"
      ],
      "grid": {
        "declared_effect": [
          "read_only",
          "recoverable_local",
          "externally_recoverable",
          "non_recoverable"
        ],
        "consequence": [
          "LOW",
          "MEDIUM",
          "HIGH",
          "CRITICAL"
        ]
      },
      "input": {
        "kind": "action",
        "action": {
          "id": "accept_terms_on_behalf_of_customer",
          "alpha": {
            "value": "human_only",
            "source": {
              "kind": "registry",
              "control": "external",
              "id": "reg://tools/accept_terms@1"
            }
          }
        },
        "obligation_records": [
          {
            "for_action": "accept_terms_on_behalf_of_customer",
            "record_control": "external",
            "party": {
              "type": "natural_person",
              "id": "idp://example.org/users/m.okafor",
              "resolvable": true
            },
            "capacity": "consenting party",
            "basis": "acknowledged_as_party",
            "acknowledged": true,
            "bound_to_action": true,
            "nonce_single_use": true,
            "performer": {
              "kind": "party",
              "id": "idp://example.org/users/m.okafor"
            }
          }
        ]
      },
      "expect": {
        "alpha_effective": "human_only",
        "alpha_trust": "PASS",
        "oversight_alpha": "HUMAN_OWNS",
        "required_oversight": "HUMAN_OWNS",
        "accountability_required": true,
        "accountability_result": "PASS",
        "gate": "proceed"
      },
      "failure_condition": "Any cell below HUMAN_OWNS. In particular the read_only/LOW cell: a human_only action that changes nothing locally still creates the obligation."
    },
    {
      "id": "P4-02-nda-consequence-ladder-honest",
