      "expect": {
        "alpha_effective": "delegable",
        "alpha_trust": "PASS",
        "oversight_alpha": "UNATTENDED",
        "accountability_required": false,
        "gate": "proceed"
      },
      "failure_condition": "Required oversight differing from the kappa verdict in any cell. alpha neither raises nor lowers a delegable action; the non_recoverable/CRITICAL cell is HUMAN_OWNS by kappa alone and needs no obligation record."
    }
