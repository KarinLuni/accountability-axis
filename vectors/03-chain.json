{
  "suite": "accountability-axis test vectors: chain establishment and the independent fold",
  "spec": "alpha-axis/0.1",
  "license": "Apache-2.0",
  "properties_covered": [
    "ALPHA-P5",
    "ALPHA-P6"
  ],
  "notes": [
    "P5: a chain is usable only if its extent was established by a component outside agent control, at plan stage, before the first untrusted read of the run.",
    "P6: the alpha fold (any human_only step raises the chain) and the kappa fold (worst declared class) are taken independently; the chain is gated at the worse of the two.",
    "The base chain is scenario C of the gap analysis: read balance -> validate -> send payment, gated at APPROVAL_REQUIRED by the kappa model with the payment's commitment invisible.",
    "Timestamps are ISO 8601 with an explicit offset. The establishment clock is outside agent control."
  ],
  "vectors": [
    {
      "id": "P6-02-payment-chain-base",
      "title": "Scenario C, closed: the payment step raises the chain through alpha while kappa stays at APPROVAL_REQUIRED",
      "properties": [
        "ALPHA-P6",
        "ALPHA-P5"
      ],
      "provenance": "KarinLuni/aisvs-c9-accountability-gap-analysis, scenario C base run",
