      },
      "expect": {
        "establishment": "PASS",
        "fold_alpha": "human_only",
        "oversight_alpha": "HUMAN_OWNS",
        "required_oversight": "HUMAN_OWNS",
        "accountability_required": true,
        "accountability_result": "PASS",
        "gate": "proceed"
      },
      "failure_condition": "APPROVAL_REQUIRED for the chain. The kappa fold is correct at APPROVAL_REQUIRED (externally_reversible); the chain still gates at HUMAN_OWNS because the alpha fold is taken separately."
    },
