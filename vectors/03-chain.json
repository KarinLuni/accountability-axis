            },
            "established_at": "2026-10-14T09:00:00Z",
            "first_untrusted_read_at": "2026-10-14T09:00:05Z"
          },
          "steps": [
            {
              "id": "read_balance",
              "declared_effect": "read_only",
              "consequence": "LOW",
              "alpha": {
                "value": "delegable",
                "source": {
                  "kind": "registry",
                  "control": "external",
                  "id": "reg://tools/read_balance@1"
                }
              }
            },
            {
              "id": "validate_payee",
              "declared_effect": "recoverable_local",
              "consequence": "LOW",
              "alpha": {
                "value": "delegable",
                "source": {
                  "kind": "registry",
                  "control": "external",
                  "id": "reg://tools/validate_payee@1"
                }
              }
            },
            {
              "id": "send_payment",
              "declared_effect": "externally_recoverable",
              "consequence": "LOW",
              "alpha": {
                "value": "human_only",
                "source": {
                  "kind": "registry",
                  "control": "external",
                  "id": "reg://tools/send_payment@5"
                }
              }
            }
          ]
        },
        "obligation_records": [
          {
            "for_action": "send_payment",
            "record_control": "external",
            "party": {
              "type": "natural_person",
              "id": "idp://example.org/users/r.haddad",
              "resolvable": true
