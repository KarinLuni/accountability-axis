{
  "suite": "accountability-axis test vectors: three results in the record, two outcomes at the gate",
  "spec": "alpha-axis/0.1",
  "license": "Apache-2.0",
  "properties_covered": [
    "ALPHA-P9"
  ],
  "notes": [
    "Every check in this specification returns PASS, FAIL or UNESTABLISHED. The record keeps all three apart. The gate collapses them to two outcomes: PASS proceeds; FAIL and UNESTABLISHED block.",
    "An implementation whose record vocabulary cannot express UNESTABLISHED separately from FAIL fails case 03 of P9-01 on the exact comparison of accountability.result.",
    "The audit also enforces two invariants on every record in the suite: an accountable party that is FAIL or UNESTABLISHED never proceeds; an establishment that is FAIL or UNESTABLISHED never proceeds."
  ],
  "vectors": [
    {
      "id": "P9-01-three-states-distinct",
      "title": "Established, rejected, unestablished: three records, two gate outcomes",
      "properties": [
        "ALPHA-P9",
        "ALPHA-P7"
      ],
      "input": {
        "kind": "action",
        "action": {
          "id": "release_escrow",
          "declared_effect": "externally_recoverable",
          "consequence": "HIGH",
          "alpha": {
            "value": "human_only",
            "source": {
              "kind": "registry",
              "control": "external",
              "id": "reg://tools/release_escrow@3"
            }
          }
        }
      },
      "expect": {
        "alpha_effective": "human_only",
        "oversight_alpha": "HUMAN_OWNS",
        "required_oversight": "HUMAN_OWNS",
        "accountability_required": true
      },
      "cases": [
        {
          "name": "01-established",
          "input": {
            "obligation_records": [
              {
                "for_action": "release_escrow",
                "record_control": "external",
                "party": {
                  "type": "natural_person",
                  "id": "idp://example.org/users/a.lindqvist",
                  "resolvable": true
                },
                "on_behalf_of": "Example Escrow Services AB",
                "capacity": "fiduciary",
                "basis": "acknowledged_as_party",
                "acknowledged": true,
                "bound_to_action": true,
                "nonce_single_use": true,
                "performer": {
                  "kind": "party",
                  "id": "idp://example.org/users/a.lindqvist"
                }
              }
            ]
          },
          "expect": {
            "accountability_result": "PASS",
            "gate": "proceed"
          }
        },
        {
          "name": "02-rejected",
          "notes": "Positive evidence of a wrong party: the agent is named as fiduciary.",
          "input": {
            "obligation_records": [
              {
                "for_action": "release_escrow",
                "record_control": "external",
                "party": {
                  "type": "agent",
                  "id": "agent://settlements/4",
                  "resolvable": true
                },
                "capacity": "fiduciary",
                "basis": "acknowledged_as_party",
                "acknowledged": true,
                "bound_to_action": true,
                "nonce_single_use": true
              }
            ]
          },
          "expect": {
            "accountability_result": "FAIL",
            "gate": "block"
          }
        },
        {
          "name": "03-unestablished",
          "notes": "No record at all. Not a soft fail: the evidence required to judge was not produced.",
          "input": {},
          "expect": {
            "accountability_result": "UNESTABLISHED",
            "gate": "block"
          }
        }
      ],
      "failure_condition": "Case 02 and case 03 reporting the same accountability.result; or either of them proceeding."
    },
    {
      "id": "P9-02-any-unestablished-check-blocks",
      "title": "A chain whose party is established but whose establishment is not still blocks",
      "properties": [
        "ALPHA-P9",
        "ALPHA-P5"
      ],
      "input": {
        "kind": "chain",
        "chain": {
          "id": "escrow-run-21",
          "establishment": {
            "establisher": {
              "kind": "orchestrator",
              "control": "unknown",
              "id": "svc://orchestrator"
            },
            "established_at": "2026-10-14T16:00:00Z",
            "first_untrusted_read_at": "2026-10-14T16:00:01Z"
          },
          "steps": [
            {
              "id": "verify_conditions",
              "declared_effect": "read_only",
              "consequence": "LOW",
              "alpha": {
                "value": "delegable",
                "source": {
                  "kind": "registry",
                  "control": "external",
                  "id": "reg://tools/verify_conditions@1"
                }
              }
            },
            {
              "id": "release_escrow",
              "declared_effect": "externally_recoverable",
              "consequence": "HIGH",
              "alpha": {
                "value": "human_only",
                "source": {
                  "kind": "registry",
                  "control": "external",
                  "id": "reg://tools/release_escrow@3"
                }
              }
            }
          ]
        },
        "obligation_records": [
          {
            "for_action": "release_escrow",
            "record_control": "external",
            "party": {
              "type": "natural_person",
              "id": "idp://example.org/users/a.lindqvist",
              "resolvable": true
            },
            "capacity": "fiduciary",
            "basis": "acknowledged_as_party",
            "acknowledged": true,
            "bound_to_action": true,
            "nonce_single_use": true,
            "performer": {
              "kind": "party",
              "id": "idp://example.org/users/a.lindqvist"
            }
          }
        ]
      },
      "expect": {
        "establishment": "UNESTABLISHED",
        "fold_alpha": "human_only",
        "oversight_alpha": "HUMAN_OWNS",
        "required_oversight": "HUMAN_OWNS",
        "accountability_required": true,
        "accountability_result": "PASS",
        "gate": "block"
      },
      "failure_condition": "Proceeding because the party is established. Every check must be PASS for the gate to open; one UNESTABLISHED anywhere closes it."
    },
    {
      "id": "P9-03-stale-control-kappa-reason-stays-visible",
      "title": "Control (scenario D): a kappa-side fail-closed verdict is recorded as kappa's, and alpha is not engaged",
      "properties": [
        "ALPHA-P9",
        "ALPHA-P6"
      ],
      "provenance": "KarinLuni/aisvs-c9-accountability-gap-analysis, scenario D (read_only + LOW + STALE binding -> HUMAN_OWNS on the kappa model, by currency)",
      "notes": "Staleness is a separate axis (OWASP/AISVS#1152) and is not modelled here; the implementation's kappa grader reports HUMAN_OWNS directly. The point of the control is that the record distinguishes a verdict reached through currency from one reached through accountability: same tier, different reason, and no obligation to attribute.",
      "input": {
        "kind": "action",
        "action": {
          "id": "query_rates_api",
          "oversight_kappa": "HUMAN_OWNS",
          "alpha": {
            "value": "delegable",
            "source": {
              "kind": "registry",
              "control": "external",
              "id": "reg://tools/query_rates_api@2"
            }
          }
        },
        "runtime_inputs": [
          {
            "kind": "kappa_binding",
            "value": "STALE",
            "claims": "declaration not usable, failed closed to irreversible (reference model rationale)"
          }
        ]
      },
      "expect": {
        "alpha_effective": "delegable",
        "oversight_alpha": "UNATTENDED",
        "required_oversight": "HUMAN_OWNS",
        "accountability_required": false,
        "gate": "proceed"
      },
      "failure_condition": "Reporting accountability as required, or attributing the HUMAN_OWNS to alpha. Agreement of verdicts is not coverage of a dimension; the record must say which axis produced the tier."
    }
  ]
}
